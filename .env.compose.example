# Docker Compose Variable Substitution
# Docker Compose が自動的に読み込む .env ファイル（コンテナ内には渡されない）
# cp .env.compose.example .env

# @rx-twitter/shared（GitHub Packages）取得用トークン。read:packages 権限が必要。
# イメージをソースからビルドする場合のみ必要（GHCR の既存イメージを使う場合は不要）
NODE_AUTH_TOKEN=

# デプロイするイメージのタグ（省略時: latest）
IMAGE_TAG=latest

# Dashboard のドメイン（jwilder/nginx-proxy が参照する）
DASHBOARD_DOMAIN=dashboard.example.com
