---
import { AnnouncementComposer } from '../../../components/AnnouncementComposer';
import Layout from '../../../layouts/Layout.astro';

// オーナー判定は src/middleware.ts で行う（非オーナーはここに到達しない）
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/');
}
---

<Layout title="お知らせの作成">
  <div class="announcements-container">
    <div class="header">
      <a href="/dashboard" class="back-link">← サーバー一覧に戻る</a>
      <h1 class="page-title">お知らせの作成</h1>
      <p class="page-description">
        Bot が参加している全サーバーへお知らせを配信します。
      </p>
    </div>

    <div class="info-box">
      <h3>配信について</h3>
      <p>
        送信したお知らせは、各サーバーの設定に従ってサーバーオーナーへの DM または
        指定チャンネルへ届きます。配信先が未設定のサーバーはオーナーへの DM になります。<br>
        Bot が停止している間に送信した場合も、再起動後に配信されます。
      </p>
    </div>

    <AnnouncementComposer client:only="preact" />
  </div>

  <style>
    .announcements-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .header {
      margin-bottom: 2rem;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 1rem;
      color: #5865f2;
      text-decoration: none;
      font-size: 0.95rem;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    .page-title {
      font-size: 2rem;
      font-weight: 700;
      margin: 0 0 0.5rem 0;
      color: #2c3e50;
    }

    .page-description {
      margin: 0;
      color: #666;
    }

    .info-box {
      background: #eef1ff;
      border: 1px solid #d5daff;
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 2rem;
    }

    .info-box h3 {
      margin: 0 0 0.5rem 0;
      font-size: 1rem;
      color: #3b4a9c;
    }

    .info-box p {
      margin: 0;
      font-size: 0.9rem;
      line-height: 1.7;
      color: #444;
    }
  </style>
</Layout>
